+def _probe_rank(rank: int, contract: dict, submission: str, warmup: int, reps: int, seed: int,
+                rendezvous: str, out_dir: str) -> None:
+    """One rank of a multi-GPU probe: build with an ``execution`` dict as the evaluator does."""
+    import traceback
+    from datetime import timedelta
+
+    import torch
+    import torch.distributed as dist
+
+    from ..cases import Case
+    from ..harness.runner import _load_submission
+    from ..tasks.parallel import initialize
+    from ..workloads import make_inputs
+
+    case = Case(**contract)
+    device = f"cuda:{rank}"
+    torch.cuda.set_device(rank)
+    row: dict = {"rank": rank}
+    initialized = False
+    try:
+        dist.init_process_group("nccl", init_method=rendezvous, world_size=case.gpus, rank=rank,
+                                timeout=timedelta(minutes=10), device_id=torch.device(device))
+        initialized = True
+        ctx = initialize(case)
+        execution = {"rank": rank, "world_size": case.gpus, "tp_rank": ctx.tp_rank,
+                     "ep_rank": ctx.ep_rank, "backend": dist.get_backend(), "device": device,
+                     "tp_group": ctx.tp_group, "ep_group": ctx.ep_group}
+        if rank == 0:
+            row["gpu_uuid"] = gpu_uuid(device)
+            row["canary_before"] = canary(device)
+        dist.barrier()
+        start = time.perf_counter()
+        candidate = _load_submission(Path(submission), case, execution=execution)
+        row["build_ms"] = (time.perf_counter() - start) * 1000
+        with torch.inference_mode():
+            inputs = make_inputs(case, seed, device)
+            torch.cuda.synchronize(device)
+            dist.barrier()
+            start = time.perf_counter()
+            candidate(inputs)
+            torch.cuda.synchronize(device)
+            row["first_call_ms"] = (time.perf_counter() - start) * 1000
+            dist.barrier()
+            row["times"] = time_candidate(candidate, inputs, device, warmup, reps)
+        dist.barrier()
+        if rank == 0:
+            row["canary_after"] = canary(device)
+    except Exception:  # noqa: BLE001
+        row["error"] = traceback.format_exc(limit=8)
+    finally:
+        (Path(out_dir) / f"rank-{rank}.json").write_text(json.dumps(row))
+        if initialized:
+            dist.destroy_process_group()
+

+def _probe_multi(shape, submission: Path, warmup: int, reps: int, seed: int) -> dict:
+    """Multi-GPU probe: one process per rank; per repetition the slowest rank counts."""
+    import tempfile
+
+    import torch.multiprocessing as mp
+
+    with tempfile.TemporaryDirectory(prefix="megabench-probe-") as directory:
+        mp.spawn(_probe_rank, nprocs=shape.gpus, join=True,
+                 args=(shape.to_dict(), str(submission), warmup, reps, seed,
+                       (Path(directory) / "rendezvous").as_uri(), directory))
+        rows = [json.loads((Path(directory) / f"rank-{r}.json").read_text())
+                for r in range(shape.gpus)]
+    errors = [r["error"] for r in rows if "error" in r]
+    if errors:
+        raise RuntimeError("probe rank failed:\n" + errors[0])
+    worst = [max(rep) for rep in zip(*(r["times"] for r in rows), strict=True)]
+    return {"p50_ms": statistics.median(worst), "build_ms": max(r["build_ms"] for r in rows),
+            "first_call_ms": max(r["first_call_ms"] for r in rows), "gpu_uuid": rows[0]["gpu_uuid"],
+            "canary_before": rows[0]["canary_before"], "canary_after": rows[0]["canary_after"]}
+

#!/bin/bash
# ./capture [--layers 1,8] [--seed 1234] [--trial 0] [--gpus N] [--cand DIR] [--cap-mb MB] [--flags "..."]
# Runs the candidate's -DSS_CAPTURE build on all ranks (./gpu_run -g N) and saves the SS_CAP records of
# the selected layers to reports/capture-<stamp>/. See TASK.d/A3.md.
set -e
WS=$(cd "$(dirname "$0")" && pwd)
GPUS=8
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --gpus) GPUS=$2; shift 2 ;;
    -h|--help) sed -n 2,4p "$0"; exec python3.12 "$WS/a3tools/capture.py" --help ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
OUT="$WS/reports/capture-$(date -u +%Y%m%dT%H%M%S)"
mkdir -p "$WS/reports"
cd "$WS"
# build outside the GPU lease (cached), then run on all ranks under a short lease
env A3_WS="$WS" PYTHONPATH="$WS:$WS/reference:$PYTHONPATH" python3.12 "$WS/a3tools/capture.py" --out "$OUT" --build-only "${ARGS[@]}"
exec ./gpu_run -g "$GPUS" -m 10 -- env A3_WS="$WS" TMPDIR=/tmp TMP=/tmp TEMP=/tmp PYTHONPATH="$WS:$WS/reference:$PYTHONPATH" \
  python3.12 -m torch.distributed.run --standalone --nproc_per_node "$GPUS" "$WS/a3tools/capture.py" --out "$OUT" "${ARGS[@]}"
